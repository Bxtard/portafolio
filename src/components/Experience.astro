---
interface Job {
  company: string;
  period: string;
  tasks?: string[];
  intro?: string;
  outro?: string;
}

const jobs: Job[] = [
  {
    company: 'OMBIA',
    period: 'Abril 2024 – Actualidad',
    intro: 'Actualmente me desempeño como Fullstack Developer en Ombia, donde he participado en el desarrollo de soluciones tecnológicas de alto impacto en el sector público y financiero, enfocadas en escalabilidad, experiencia de usuario y procesamiento eficiente de datos.',
    tasks: [
      'En el proyecto ARIS, contribuí al desarrollo del portal de impuestos del Atlántico, liderando la migración de datos desde un sistema legacy hacia una arquitectura moderna basada en PostgreSQL. Además, fui co-responsable del módulo de rentas, donde optimizamos la experiencia del usuario y simplificamos el proceso de declaración. Estas mejoras permitieron reducir significativamente la fricción del sistema anterior, eliminando problemas como caídas de sesión y procesos repetitivos, lo que facilitó que más usuarios pudieran declarar de manera autónoma sin depender de intermediarios. Asimismo, implementé integraciones de pagos virtuales que permitieron realizar el pago en minutos directamente desde la plataforma, contribuyendo a la reducción de la morosidad.',
      'Posteriormente, participé en el proyecto ARIEL, una solución basada en inteligencia artificial para consultas legales. Allí desarrollé casos de uso dinámicos que transforman formularios de usuario en prompts estructurados, mejorando la precisión y relevancia de las respuestas generadas. Adicionalmente, resolví un problema crítico de escalabilidad relacionado con el cargue masivo de documentos, diseñando e implementando un sistema de procesamiento asíncrono mediante colas utilizando Redis y Amazon SQS. Esta solución evitó la sobrecarga de memoria en el servidor y permitió manejar grandes volúmenes de información de forma eficiente y estable.',
      'Actualmente, formo parte del desarrollo de una plataforma de planeación financiera para Findeter, orientada a la proyección de escenarios financieros a 15 años. En este sistema se modelan variables complejas como deuda externa, inversiones, flujo de caja, bonos, cartera activa, operaciones en moneda extranjera, nómina y préstamos. Mi rol se centra en el desarrollo fullstack de funcionalidades críticas y en la construcción de una arquitectura robusta capaz de soportar grandes volúmenes de datos y cálculos financieros estratégicos.',
    ],
    outro: 'A lo largo de estos proyectos, he trabajado con tecnologías como Next.js, NestJS, TypeORM, PostgreSQL, Angular, .NET Core, SQL Server, Redis, Amazon SQS, Supabase, Azure Blob Storage y Python, fortaleciendo mis habilidades en diseño de sistemas escalables, optimización de rendimiento y desarrollo orientado a impacto.',
  },
  {
    company: 'SAROCA TEC SAS',
    period: 'Noviembre 2022 – Marzo 2024',
    intro: 'Durante mi experiencia en Saroca Tec SAS, participé en el mantenimiento y evolución de múltiples productos relacionados con el ecosistema de criptomonedas.',
    tasks: [
      'Trabajé en Bault.io, una plataforma orientada a la compra de activos como Bitcoin y Tether, donde estuve enfocado en la mejora de la interfaz gráfica y en la refactorización del código, contribuyendo a una experiencia de usuario más clara y a una base de código más mantenible.',
      'Formé parte del desarrollo de Criptomatch, una aplicación construida desde cero para el intercambio P2P de criptomonedas como Ethereum, Bitcoin, Tether y Dogecoin. Participé activamente en la construcción de funcionalidades clave y en la evolución del producto en sus primeras etapas.',
      'Trabajé en la implementación de sistemas de métricas y herramientas internas para la gestión de PQRS y analítica, utilizadas por los equipos de soporte de las diferentes plataformas. Estas soluciones estaban inicialmente desarrolladas en Meteor.js, con aplicaciones independientes para cada producto.',
      'Gracias a mi desempeño y capacidad de liderazgo, fui promovido a líder de equipo, donde asumí la responsabilidad de dirigir la migración de estas aplicaciones hacia una arquitectura moderna basada en Next.js (frontend) y NestJS (backend). Este proceso incluyó la eliminación de funcionalidades redundantes, la optimización del código y la unificación de sistemas, logrando un incremento aproximado del 70% en la velocidad y rendimiento de las aplicaciones.',
    ],
  },
  {
    company: 'Web Developer Freelance',
    period: '6 meses',
    tasks: [
      'Construcción de aplicaciones web con Vite, React, Next.js, HTML, CSS y JavaScript.',
      'Desarrollo de APIs con Node.js usando Express y Nest.js.',
    ],
  },
];

const education = [
  { title: 'Fullstack Web Development', place: 'Make It Real Camp', year: '2022' },
  { title: 'Ingeniería de Sistemas', place: 'Universidad del Norte, Barranquilla', year: '2017' },
];
---

<section id="experiencia" aria-label="Experiencia laboral y educación">
  <h2>Experiencia</h2>

  <div class="timeline">
    {jobs.map((job, i) => (
      <div class="timeline__item">
        <div class="timeline__dot" aria-hidden="true"></div>
        <div class="timeline__card glass-card">
          <h3 class="timeline__company">{job.company}</h3>
          <span class="timeline__period">{job.period}</span>
          {job.intro && <p class="timeline__intro">{job.intro}</p>}
          <ul class="timeline__tasks">
            {job.tasks?.map((task) => (
              <li>{task}</li>
            ))}
          </ul>
          {job.outro && <p class="timeline__outro">{job.outro}</p>}
        </div>
      </div>
    ))}
  </div>

  <h2 style="margin-top: 2.5rem;">Educación</h2>

  <div class="edu-grid">
    {education.map((edu) => (
      <div class="glass-card edu-card">
        <h3 class="edu-card__title">{edu.title}</h3>
        <p class="edu-card__place">{edu.place}</p>
        <span class="edu-card__year">{edu.year}</span>
      </div>
    ))}
  </div>
</section>

<style>
  /* Timeline */
  .timeline {
    position: relative;
    max-width: 960px;
    margin: 0 auto;
    padding-left: 2rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(to bottom, var(--accent-magenta), var(--accent-purple), var(--accent-cyan));
    box-shadow: 0 0 8px var(--accent-purple);
  }

  .timeline__item {
    position: relative;
    margin-bottom: 2.5rem;
  }

  .timeline__dot {
    position: absolute;
    left: -2rem;
    top: 1.2rem;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--accent-purple);
    border: 2px solid var(--accent-cyan);
    box-shadow: 0 0 10px var(--accent-purple);
    transform: translateX(calc(-50% + 8px));
  }

  .timeline__card {
    margin-left: 0.5rem;
  }

  .timeline__company {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--accent-magenta);
    margin-bottom: 0.3rem;
  }

  .timeline__period {
    display: block;
    font-size: 0.8rem;
    color: var(--accent-cyan);
    margin-bottom: 1rem;
    letter-spacing: 0.05em;
  }

  .timeline__tasks {
    list-style: none;
    padding: 0;
  }

  .timeline__tasks li {
    position: relative;
    padding-left: 1.2rem;
    margin-bottom: 0.6rem;
    color: var(--text-primary);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .timeline__tasks li::before {
    content: '▹';
    position: absolute;
    left: 0;
    color: var(--accent-cyan);
  }

  .timeline__intro,
  .timeline__outro {
    color: var(--text-primary);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .timeline__intro {
    margin-bottom: 0.9rem;
  }

  .timeline__outro {
    margin-top: 0.9rem;
  }

  /* Education */
  .edu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    max-width: 960px;
    margin: 0 auto;
  }

  .edu-card__title {
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--accent-magenta);
    margin-bottom: 0.3rem;
  }

  .edu-card__place {
    color: var(--text-secondary);
    font-size: 0.85rem;
    margin-bottom: 0.5rem;
  }

  .edu-card__year {
    font-size: 0.8rem;
    color: var(--accent-cyan);
  }

  @media (max-width: 640px) {
    .timeline {
      padding-left: 1.5rem;
    }
    .timeline__dot {
      left: -1.5rem;
    }
  }
</style>
