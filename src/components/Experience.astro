const education = [
  { title: 'Fullstack Web Development', titleEn: 'Fullstack Web Development', place: 'Make It Real Camp', year: '2022' },
  { title: 'Ingeniería de Sistemas', titleEn: 'Systems Engineering', place: 'Universidad del Norte, Barranquilla', year: '2017' },
];
---

<section id="experiencia" aria-label="Experiencia laboral y educación">
  <h2><span class="lang-es">Experiencia</span><span class="lang-en">Experience</span></h2>

  <div class="timeline">
    {jobs.map((job, i) => (
      <div class="timeline__item">
        <div class="timeline__dot" aria-hidden="true"></div>
        <div class="timeline__card glass-card">
          <h3 class="timeline__company">{job.company}</h3>
          <span class="timeline__period">
            <span class="lang-es">{job.period}</span>
            {job.periodEn && <span class="lang-en">{job.periodEn}</span>}
          </span>
          {job.intro && <p class="timeline__intro lang-es">{job.intro}</p>}
          {job.introEn && <p class="timeline__intro lang-en">{job.introEn}</p>}
          <ul class="timeline__tasks lang-es">
            {job.tasks?.map((task) => (
              <li>{task}</li>
            ))}
          </ul>
          {job.tasksEn && (
            <ul class="timeline__tasks lang-en">
              {job.tasksEn.map((task) => (
                <li>{task}</li>
              ))}
            </ul>
          )}
          {job.outro && <p class="timeline__outro lang-es">{job.outro}</p>}
          {job.outroEn && <p class="timeline__outro lang-en">{job.outroEn}</p>}
        </div>
      </div>
    ))}
  </div>

  <h2 style="margin-top: 2.5rem;"><span class="lang-es">Educación</span><span class="lang-en">Education</span></h2>

  <div class="edu-grid">
    {education.map((edu) => (
      <div class="glass-card edu-card">
        <h3 class="edu-card__title">
          <span class="lang-es">{edu.title}</span>
          <span class="lang-en">{edu.titleEn}</span>
        </h3>
        <p class="edu-card__place">{edu.place}</p>
        <span class="edu-card__year">{edu.year}</span>
      </div>
    ))}
  </div>
</section>

<style>
  /* Timeline */
  .timeline {
    position: relative;
    max-width: 960px;
    margin: 0 auto;
    padding-left: 2rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(to bottom, var(--accent-magenta), var(--accent-purple), var(--accent-cyan));
    box-shadow: 0 0 8px var(--accent-purple);
  }

  .timeline__item {
    position: relative;
    margin-bottom: 2.5rem;
  }

  .timeline__dot {
    position: absolute;
    left: -2rem;
    top: 1.2rem;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--accent-purple);
    border: 2px solid var(--accent-cyan);
    box-shadow: 0 0 10px var(--accent-purple);
    transform: translateX(calc(-50% + 8px));
  }

  .timeline__card {
    margin-left: 0.5rem;
  }

  .timeline__company {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--accent-magenta);
    margin-bottom: 0.3rem;
  }

  .timeline__period {
    display: block;
    font-size: 0.8rem;
    color: var(--accent-cyan);
    margin-bottom: 1rem;
    letter-spacing: 0.05em;
  }

  .timeline__tasks {
    list-style: none;
    padding: 0;
  }

  .timeline__tasks li {
    position: relative;
    padding-left: 1.2rem;
    margin-bottom: 0.6rem;
    color: var(--text-primary);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .timeline__tasks li::before {
    content: '▹';
    position: absolute;
    left: 0;
    color: var(--accent-cyan);
  }

  .timeline__intro,
  .timeline__outro {
    color: var(--text-primary);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .timeline__intro {
    margin-bottom: 0.9rem;
  }

  .timeline__outro {
    margin-top: 0.9rem;
  }

  /* Education */
  .edu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    max-width: 960px;
    margin: 0 auto;
  }

  .edu-card__title {
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--accent-magenta);
    margin-bottom: 0.3rem;
  }

  .edu-card__place {
    color: var(--text-secondary);
    font-size: 0.85rem;
    margin-bottom: 0.5rem;
  }

  .edu-card__year {
    font-size: 0.8rem;
    color: var(--accent-cyan);
  }

  @media (max-width: 640px) {
    .timeline {
      padding-left: 1.5rem;
    }
    .timeline__dot {
      left: -1.5rem;
    }
  }
</style>
